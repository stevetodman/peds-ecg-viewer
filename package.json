{
  "name": "peds-ecg-viewer",
  "version": "0.1.0",
  "description": "Pediatric ECG viewer with age-adjusted normal values",
  "type": "module",
  "main": "./dist/peds-ecg-viewer.js",
  "module": "./dist/peds-ecg-viewer.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/peds-ecg-viewer.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:digitizer:research": "vitest run tests/integration/digitizer/round-trip.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:visual": "vitest --project visual",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "lint": "eslint src --ext .ts,.tsx --quiet",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lfs:verify": "node scripts/verify-lfs-artifacts.mjs",
    "package:check": "node scripts/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "ecg",
    "ekg",
    "electrocardiogram",
    "pediatric",
    "cardiology",
    "medical"
  ],
  "author": "Steven Todman",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevetodman/peds-ecg-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/stevetodman/peds-ecg-viewer/issues"
  },
  "homepage": "https://github.com/stevetodman/peds-ecg-viewer#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "canvas": "^3.2.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
